VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PHOTO_BUCKET=photos
VITE_SITE_URL=https://your-vercel-domain.vercel.app

# Emergency deployment capability gates — both default OFF when absent.
# Once set true in a deployed environment, Admin → Shop owns the immediate
# public on/off and manual/Prodigi runtime switches. Missing DB state is manual.
VITE_SHOP_ENABLED=false
SHOP_CHECKOUT_ENABLED=false

# Stripe — only the publishable key may use VITE_. Never expose the secret key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional paid invoice PDFs for one-time Checkout payments (Stripe prices
# these separately). Ordinary Stripe receipts remain available when false.
STRIPE_PAID_INVOICES_ENABLED=false

# Prodigi defaults to sandbox unless this base URL is changed explicitly.
PRODIGI_API_KEY=replace_with_sandbox_key
PRODIGI_API_BASE_URL=https://api.sandbox.prodigi.com/v4.0
PRODIGI_CALLBACK_SECRET=generate_a_long_random_value

# Server-only shop services.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
CRON_SECRET=generate_a_long_random_value
SITE_URL=https://www.samduckworth.com
RESEND_API_KEY=re_replace_me
SHOP_EMAIL_FROM=Sam Duckworth Photography <orders@mail.samduckworth.com>
SHOP_ALERT_EMAIL=your-email@example.com
SHOP_INSTAGRAM_URL=https://instagram.com/sam.duckworth
